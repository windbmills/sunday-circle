rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownerEmail() {
      return 'windmills34@gmail.com';
    }
    function signedIn() {
      return request.auth != null;
    }
    function userEmail() {
      return signedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }
    function isOwner() {
      return signedIn() && userEmail() == ownerEmail();
    }
    function isEditor() {
      return isOwner()
        || (signedIn()
            && request.auth.token.email_verified == true
            && userEmail() != ''
            && exists(/databases/$(database)/documents/editors/$(userEmail())));
    }

    match /meta/{doc} {
      allow read: if true;
      allow write: if isEditor() && doc in ['cover', 'topic'];
    }

    match /editors/{editorId} {
      allow read: if isEditor();
      allow create, update: if isOwner()
        && request.resource.data.email is string
        && editorId == request.resource.data.email.lower()
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 80;
      allow delete: if isOwner();
    }

    match /thoughts/{id} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.author is string
                    && request.resource.data.author.size() >= 2
                    && request.resource.data.author.size() <= 40
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 3
                    && request.resource.data.text.size() <= 600;
      allow delete: if isEditor();
      allow update: if false;
    }
  }
}
